{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "import", "oxc", "promise", "vitest"],
	"categories": {
		"correctness": "error",
		"suspicious": "error",
		"perf": "error"
	},
	"rules": {
		"typescript/no-unsafe-type-assertion": "off",
		"import/no-unassigned-import": [
			"error",
			{
				"allow": ["**/*.css"]
			}
		]
	},
	"env": {
		"browser": true,
		"webextensions": true
	},
	"ignorePatterns": ["distribution", "web-ext-artifacts", "website/dist", "website/.astro"]
}
