{
	"lineWidth": 120,
	"useTabs": true,
	"typescript": {
		"quoteStyle": "preferSingle",
		"bracePosition": "sameLine",
		"objectExpression.spaceSurroundingProperties": false,
		"objectPattern.spaceSurroundingProperties": false,
		"typeLiteral.spaceSurroundingProperties": false,
		"importDeclaration.spaceSurroundingNamedImports": false,
		"exportDeclaration.spaceSurroundingNamedExports": false
	},
	"excludes": ["distribution", "web-ext-artifacts", "**/node_modules", "package-lock.json"],
	"plugins": [
		"./node_modules/@dprint/typescript/plugin.wasm",
		"./node_modules/@dprint/json/plugin.wasm",
		"./node_modules/@dprint/markdown/plugin.wasm"
	]
}
