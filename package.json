{
	"name": "github-power",
	"version": "0.0.0",
	"private": "true",
	"description": "Browser extension (Chrome & Firefox) that adds superpowers to GitHub",
	"homepage": "https://github.com/vmaerten/github-power#readme",
	"bugs": {
		"url": "https://github.com/vmaerten/github-power/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/vmaerten/github-power.git"
	},
	"type": "module",
	"scripts": {
		"build": "tsdown",
		"watch": "tsdown --watch",
		"start:chrome": "web-ext run --source-dir distribution --target chromium --start-url https://github.com/vmaerten/github-power",
		"start:firefox": "web-ext run --source-dir distribution --target firefox-desktop --start-url https://github.com/vmaerten/github-power",
		"lint": "eslint . && dprint check",
		"format": "dprint fmt",
		"typecheck": "svelte-check --fail-on-warnings",
		"test": "vitest run"
	},
	"dependencies": {
		"dom-chef": "^5.2.0",
		"element-ready": "^9.0.2",
		"github-url-detection": "^11.2.4",
		"select-dom": "^10.1.0"
	},
	"devDependencies": {
		"@dprint/json": "^0.25.2",
		"@dprint/markdown": "^0.28.2",
		"@dprint/typescript": "^0.96.1",
		"@eslint/js": "^10.0.1",
		"@types/chrome": "^0.3.7",
		"dprint": "^0.64.3",
		"eslint": "^10.14.0",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"happy-dom": "^21.0.4",
		"npm-run-all2": "^9.0.4",
		"rollup-plugin-svelte": "^7.2.3",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tsdown": "^0.23.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vitest": "^5.0.5",
		"web-ext": "^10.8.0"
	},
	"packageManager": "pnpm@12.15.0"
}
