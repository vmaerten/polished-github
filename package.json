{
	"name": "github-power",
	"version": "0.0.0",
	"private": "true",
	"description": "Browser extension (Chrome & Firefox) that adds superpowers to GitHub",
	"homepage": "https://github.com/vmaerten/github-power#readme",
	"bugs": {
		"url": "https://github.com/vmaerten/github-power/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/vmaerten/github-power.git"
	},
	"type": "module",
	"scripts": {
		"build": "tsdown",
		"watch": "tsdown --watch",
		"start:chrome": "web-ext run --source-dir distribution --target chromium --start-url https://github.com/vmaerten/github-power",
		"start:firefox": "web-ext run --source-dir distribution --target firefox-desktop --start-url https://github.com/vmaerten/github-power",
		"lint": "oxlint --type-aware --deny-warnings && oxfmt --check",
		"format": "oxfmt",
		"typecheck": "rm -rf .svelte-check && svelte-check --tsgo --fail-on-warnings",
		"test": "vitest run"
	},
	"dependencies": {
		"dom-chef": "^5.2.0",
		"element-ready": "^9.0.2",
		"github-url-detection": "^11.2.4",
		"select-dom": "^10.1.0"
	},
	"devDependencies": {
		"@types/chrome": "^0.3.7",
		"@typescript/native": "npm:typescript@7",
		"happy-dom": "^21.0.4",
		"npm-run-all2": "^9.0.4",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.90.0",
		"oxlint-tsgolint": "^7.0.2005",
		"rollup-plugin-svelte": "^7.2.3",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tsdown": "^0.23.4",
		"typescript": "~6.0.3",
		"vitest": "^5.0.5",
		"web-ext": "^10.8.0"
	},
	"packageManager": "pnpm@12.15.0"
}
