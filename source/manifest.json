{
	"$schema": "https://json.schemastore.org/chrome-manifest",
	"manifest_version": 3,
	"name": "Polished GitHub",
	"version": "0.0.0",
	"description": "Review pull requests faster on GitHub. Not affiliated with GitHub, Inc.",
	"homepage_url": "https://github.com/vmaerten/polished-github",
	"minimum_chrome_version": "120",
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"browser_specific_settings": {
		"gecko": {
			"id": "polished-github@vmaerten",
			"strict_min_version": "140.0",
			"data_collection_permissions": {
				"required": ["none"],
				"optional": ["authenticationInfo", "browsingActivity"]
			}
		}
	},
	"permissions": ["storage"],
	"options_ui": {
		"page": "options.html",
		"open_in_tab": true
	},
	"content_scripts": [
		{
			"matches": ["https://github.com/*"],
			"js": ["content-script.js"]
		}
	]
}
