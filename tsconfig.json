{
	"compilerOptions": {
		"target": "ES2023",
		"module": "preserve",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"lib": ["DOM", "DOM.Iterable", "ES2023"],
		"jsx": "react",
		"strict": true,
		"noEmit": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"types": ["chrome"]
	},
	"include": ["source", "build", "*.ts"]
}
