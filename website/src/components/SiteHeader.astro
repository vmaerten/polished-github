---
import ThemeSwitch from './ThemeSwitch.astro';

export interface NavLink {
	href: string;
	label: string;
}

interface Props {
	nav?: NavLink[];
}

const {
	nav = [
		{href: '/features/', label: 'All features'},
		{href: '/#install', label: 'Install'},
	],
} = Astro.props;
---

<header class="site-header">
	<nav class="wrap nav" aria-label="Main">
		<a class="brand" href="/"
			><img class="brand-mark" src="/logo.svg" alt="" width="28" height="28" />Supercharged
			<span class="brand-light">GitHub</span></a
		>
		<div class="nav-links">
			{
				nav.map(({href, label}) => (
					<a href={href} aria-current={href === Astro.url.pathname ? 'page' : undefined}>
						{label}
					</a>
				))
			}
			<a class="nav-source" href="https://github.com/vmaerten/supercharged-github">Source on GitHub</a>
		</div>
		<ThemeSwitch />
	</nav>
</header>
