---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found">
	<main class="wrap hero not-found">
		<p class="eyebrow mono">404</p>
		<h1>This page was never merged.</h1>
		<p class="lede">The link may be old, or the page may have moved. The rest of the site is still here.</p>
		<pre class="panel not-found-diff" aria-hidden="true"><span class="hunk">@@ -1 +1 @@</span>
<span class="del">- <span id="missing-path">/this-page</span></span>
<span class="add">+ /</span></pre>
		<div class="actions">
			<a class="btn btn-primary" href="/">Back to home</a>
			<a class="btn btn-secondary" href="/features/">See all features</a>
		</div>
	</main>

	<script>
		document.getElementById('missing-path').textContent = location.pathname;
	</script>
</Layout>
