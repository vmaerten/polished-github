---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About">
	<main class="wrap about">
		<header class="about-hero">
			<img class="about-avatar" src="/avatar.jpg" width="120" height="120" alt="Valentin Maerten" />
			<div class="doc-head">
				<p class="eyebrow">About</p>
				<h1>One developer, a lot of pull requests</h1>
				<p class="lede">
					I'm Valentin, a developer in Tours, France. I build Polished GitHub alone, on my own time, to make the reviews
					I do every day a little faster.
				</p>
			</div>
		</header>

		<div class="cards">
			<div class="panel card">
				<h2>Why it exists</h2>
				<p class="muted">
					GitHub is great, but some screens make you click around to answer simple questions: which pull request is
					waiting on me, who has room for a review. Each feature answers one of them.
				</p>
			</div>
			<div class="panel card">
				<h2>What it promises</h2>
				<p class="muted">
					No account, no analytics, no ads. Your token stays on your device and only talks to the GitHub API.
				</p>
			</div>
			<div class="panel card">
				<h2>How it's built</h2>
				<p class="muted">
					Open source under the MIT license, in TypeScript and Svelte. Ideas and bug reports go to the <a
						href="https://github.com/vmaerten/polished-github/issues">issue tracker</a
					>.
				</p>
			</div>
		</div>

		<section class="panel about-support">
			<div>
				<h2>Keep it going</h2>
				<p class="muted">
					If Polished GitHub saves you time, a sponsorship pays for the evenings I spend on it. Starring the repository
					helps too.
				</p>
			</div>
			<div class="actions">
				<a class="btn btn-secondary btn-sponsor" href="https://github.com/sponsors/vmaerten"
					><svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"
						><path
							d="m8 14.25.345.666a.75.75 0 0 1-.69 0l-.008-.004-.018-.01a7.152 7.152 0 0 1-.31-.17 22.055 22.055 0 0 1-3.434-2.414C2.045 10.731 0 8.35 0 5.5 0 2.836 2.086 1 4.25 1 5.797 1 7.153 1.802 8 3.02 8.847 1.802 10.203 1 11.75 1 13.914 1 16 2.836 16 5.5c0 2.85-2.045 5.231-3.885 6.818a22.066 22.066 0 0 1-3.744 2.584l-.018.01-.006.003h-.002ZM4.25 2.5c-1.336 0-2.75 1.164-2.75 3 0 2.15 1.58 4.144 3.365 5.682A20.58 20.58 0 0 0 8 13.393a20.58 20.58 0 0 0 3.135-2.211C12.92 9.644 14.5 7.65 14.5 5.5c0-1.836-1.414-3-2.75-3-1.373 0-2.609.986-3.029 2.456a.749.749 0 0 1-1.442 0C6.859 3.486 5.623 2.5 4.25 2.5Z"
						></path></svg
					>Sponsor on GitHub</a
				>
				<a class="btn btn-coffee" href="https://buymeacoffee.com/vmaerten"
					><svg
						width="16"
						height="16"
						viewBox="0 0 16 16"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
						><path d="M2.5 6.5h9v4a3.5 3.5 0 0 1-3.5 3.5H6a3.5 3.5 0 0 1-3.5-3.5v-4Z"></path><path
							d="M11.5 7.5h1a1.75 1.75 0 0 1 0 3.5h-1.2"></path><path d="M5 1.5c-.5.8.5 1.4 0 2.5M8 1.5c-.5.8.5 1.4 0 2.5"
						></path></svg
					>Buy me a coffee</a
				>
			</div>
		</section>
	</main>
</Layout>
