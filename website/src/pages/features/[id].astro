---
import {render} from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import {featureUrl, getFeatures, groups, hasPage, type Feature} from '../../features';

export async function getStaticPaths() {
	const features = await getFeatures();
	return features.filter(hasPage).map((feature) => ({params: {id: feature.id}, props: {feature, features}}));
}

interface Props {
	feature: Feature;
	features: Feature[];
}

const {feature, features} = Astro.props;
const {Content} = await render(feature);
const {title, group, lede, summary, appearsIn, needsToken, onByDefault} = feature.data;
---

<Layout title={title}>
	<div class="wrap doc">
		<nav class="sidebar" aria-label="Features">
			{
				groups
					.filter((g) => features.some((f) => f.data.group === g))
					.map((g) => (
					<div>
						<span class="side-group">{g}</span>
						{features
							.filter((f) => f.data.group === g)
							.map((f) =>
								hasPage(f) ? (
									<a href={featureUrl(f)} aria-current={f.id === feature.id ? 'page' : undefined}>
										{f.data.title}
									</a>
								) : (
									<span class="side-item">
										{f.data.title}
									</span>
								),
							)}
					</div>
				))
			}
		</nav>

		<main class="doc-main">
			<div class="doc-head">
				<p class="crumbs"><a href="/features/">Features</a> / {group}</p>
				<h1>{title}</h1>
				<p class="lede">{lede ?? summary}</p>
				<div class="tags" style="font-size: 13px">
					<span class="tag">Appears in: {appearsIn}</span>
					{needsToken && <span class="tag tag-token">Needs token</span>}
					{onByDefault && <span class="tag tag-on">On by default</span>}
				</div>
			</div>

			<div class="doc-body">
				<Content />
			</div>

			<nav class="pager" aria-label="Next and previous feature">
				<a class="panel" href="/features/"><small>Back to</small>All features</a>
				<a class="panel" href="/#demo"><small>See it live</small>Demo on the home page</a>
			</nav>
		</main>
	</div>
</Layout>
