---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="All features">
	<main class="wrap">
		<section class="cat-head">
			<div style="display: flex; flex-direction: column; gap: 8px">
				<h1>All features</h1>
				<p class="muted">6 available, 7 coming. Every one can be turned off in the options.</p>
			</div>
			<div class="filters">
				<label for="feature-search" class="sr-only">Search features</label>
				<input id="feature-search" type="search" placeholder="Search features" autocomplete="off" />
				<div class="chips" role="group" aria-label="Filter by moment">
					<button type="button" data-group="All" aria-pressed="true">All</button>
					<button type="button" data-group="Triage" aria-pressed="false">Triage</button>
					<button type="button" data-group="Reviewing code" aria-pressed="false">Reviewing code</button>
					<button type="button" data-group="Discussing" aria-pressed="false">Discussing</button>
					<button type="button" data-group="Reading" aria-pressed="false">Reading</button>
				</div>
			</div>
		</section>

		<section class="cat-grid" aria-label="Features" id="grid">
			<a class="panel cat-card" href="/features/review-status/" data-group="Triage">
				<span class="top">Review status</span>
				<p>Where each PR stands for you, on every row of the list.</p>
				<span class="tags"
					><span class="tag">PR list</span><span class="tag tag-muted">Triage</span
					><span class="tag tag-token">Needs token</span></span
				>
			</a>
			<div class="panel cat-card" data-group="Triage">
				<span class="top">Diff stats</span>
				<p>Lines added and removed, files and a size label.</p>
				<span class="tags"
					><span class="tag">PR list</span><span class="tag tag-muted">Triage</span
					><span class="tag tag-token">Needs token</span></span
				>
			</div>
			<div class="panel cat-card" data-group="Triage">
				<span class="top">Idle PRs</span>
				<p>Days since the last activity, past a threshold you set.</p>
				<span class="tags"
					><span class="tag">PR list</span><span class="tag tag-muted">Triage</span
					><span class="tag tag-token">Needs token</span></span
				>
			</div>
			<div class="panel cat-card" data-group="Triage">
				<span class="top">Reviewer load</span>
				<p>Pending reviews per person, where you pick reviewers.</p>
				<span class="tags"
					><span class="tag">Reviewers picker</span><span class="tag tag-muted">Triage</span
					><span class="tag tag-token">Needs token</span></span
				>
			</div>
			<div class="panel cat-card" data-group="Reviewing code">
				<span class="top">Collapse generated files <span class="soon">Soon</span></span>
				<p>Lockfiles and generated code start collapsed in the diff.</p>
				<span class="tags"
					><span class="tag">Files changed</span><span class="tag tag-muted">Reviewing code</span></span
				>
			</div>
			<div class="panel cat-card" data-group="Reviewing code">
				<span class="top">Folder diff stats <span class="soon">Soon</span></span>
				<p>Lines changed per folder in the file tree.</p>
				<span class="tags"
					><span class="tag">Files changed</span><span class="tag tag-muted">Reviewing code</span></span
				>
			</div>
			<div class="panel cat-card" data-group="Reviewing code">
				<span class="top">Weighted review progress <span class="soon">Soon</span></span>
				<p>Progress by lines viewed, not by files.</p>
				<span class="tags"
					><span class="tag">Files changed</span><span class="tag tag-muted">Reviewing code</span></span
				>
			</div>
			<div class="panel cat-card" data-group="Discussing">
				<span class="top">Quick comments</span>
				<p>Your usual replies as one-click buttons above the comment box.</p>
				<span class="tags"><span class="tag">Comment box</span><span class="tag tag-muted">Discussing</span></span>
			</div>
			<div class="panel cat-card" data-group="Discussing">
				<span class="top">Conventional Comments <span class="soon">Soon</span></span>
				<p>Label a comment as praise, nit, issue or question.</p>
				<span class="tags"><span class="tag">Comment box</span><span class="tag tag-muted">Discussing</span></span>
			</div>
			<div class="panel cat-card" data-group="Discussing">
				<span class="top">Unresolved conversations <span class="soon">Soon</span></span>
				<p>Count the open threads and jump between them.</p>
				<span class="tags"><span class="tag">Conversation</span><span class="tag tag-muted">Discussing</span></span>
			</div>
			<div class="panel cat-card" data-group="Reading">
				<span class="top">Ticket links <span class="soon">Soon</span></span>
				<p>Ticket ids like ABC-123 link to your issue tracker.</p>
				<span class="tags"><span class="tag">Conversation</span><span class="tag tag-muted">Reading</span></span>
			</div>
			<div class="panel cat-card" data-group="Reading">
				<span class="top">Image modal</span>
				<p>Zoom images in place, arrow keys between them.</p>
				<span class="tags"><span class="tag">Images</span><span class="tag tag-muted">Reading</span></span>
			</div>
			<div class="panel cat-card" data-group="Reading">
				<span class="top">Before/after slider <span class="soon">Soon</span></span>
				<p>Two images labelled Before and After become a slider.</p>
				<span class="tags"><span class="tag">Images</span><span class="tag tag-muted">Reading</span></span>
			</div>
			<p class="empty" id="empty" hidden>
				No feature matches. <a href="https://github.com/vmaerten/supercharged-github/issues/new">Suggest one</a>
			</p>
		</section>
	</main>

	<script>
		const search = document.getElementById('feature-search');
		const chips = document.querySelectorAll('.chips button');
		const cards = document.querySelectorAll('.cat-card');
		const empty = document.getElementById('empty');
		let group = 'All';
		function apply() {
			const q = search.value.trim().toLowerCase();
			let shown = 0;
			cards.forEach((card) => {
				const match = (group === 'All' || card.dataset.group === group) && card.textContent.toLowerCase().includes(q);
				card.hidden = !match;
				if (match) shown++;
			});
			empty.hidden = shown > 0;
		}
		chips.forEach((chip) => {
			chip.addEventListener('click', () => {
				group = chip.dataset.group;
				chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
				apply();
			});
		});
		search.addEventListener('input', apply);
	</script>
</Layout>
